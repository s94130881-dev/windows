{
  "name": "Windows 10 Pro",
  "service": "windows",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "300gb"
  },
  "containerEnv": {
    "VERSION": "10"
  },
  "forwardPorts": [
    8006,
    3389
  ],
  "portsAttributes": {
    "8006": {
      "label": "Windows Web",
      "onAutoForward": "openPreview"
    },
    "3389": {
      "label": "Windows RDP",
      "onAutoForward": "notify"
    }
  },
  "dockerComposeFile": "../codespaces.yml",
  "initializeCommand": "docker system prune --all --force"
}
